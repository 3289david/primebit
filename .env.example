# ── 브랜드/커스터마이징 (다른 운영자가 이 코드로 자기 서비스를 만들 때) ──
SHOP_NAME=MyCoinExchange  # 디스코드 임베드/음성채널/관리자 패널 제목 등 전체에 사용됩니다
BRAND_COLOR=2B6DF6        # 임베드 색상 (hex, # 없이)

# ── 디스코드 봇 ───────────────────────
DISCORD_TOKEN=
GUILD_ID=
ADMIN_ROLE_ID=            # 관리자 역할 (알림 멘션, 티켓 열람, 이 역할 보유자는 패널 로그인 가능)
ADMIN_LOG_CHANNEL_ID=     # 관리자 전용 로그 채널 (매입신청, 오류, 미매칭 입금, 로그인 알림, KYC 처리 알림)
ALERT_CHANNEL_ID=         # 재고 부족/재입고/공지 알림 채널
TRADE_LOG_CHANNEL_ID=     # 공개 거래 로그 채널 (이름 마스킹, 선택)
TICKET_CATEGORY_ID=       # 문의/KYC 증빙 채널이 생성될 카테고리 (선택)
STOCK_ROLE_ID=            # 재입고 알림 받기 역할 (선택)
PANEL_CHANNEL_ID=         # 봇이 처음 켜질 때 메인 패널을 자동 설치할 채널 (선택, 1회만 실행됨)
STATUS_CHANNEL_ID=        # 봇이 처음 켜질 때 실시간 현황 임베드를 자동 설치할 채널 (선택, 1회만 실행됨)

# ── 관리자 패널: 디스코드 OAuth2 로그인 ──
# 개발자 포털 > OAuth2 > Redirects 에 {PUBLIC_URL}/admin/callback 등록 (예: https://exchange.example.com/admin/callback)
PUBLIC_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_DISCORD_IDS=        # 로그인 허용할 디스코드 유저 ID (쉼표로 여러 명). ADMIN_ROLE_ID 보유자도 허용
SESSION_SECRET=           # 아무 긴 랜덤 문자열 (세션 서명용)

# ── 본인인증 / KYC (법적으로 인증된 유저만 충전·구매 가능하게 강제) ──
# 휴대폰 "번호 소유 확인"은 Octomo(https://octomo.octoverse.kr) API를 사용합니다.
# 가입 후 마이페이지에서 API Key 발급 — 실명/주민번호 대조가 아닌 "그 번호를 실제로 쓰는지"만 확인하는 서비스입니다.
# KYC(신분증 대조)는 자체 API 연동 없이 유저가 제출한 증빙자료를 관리자가 수동 승인/반려합니다.
OCTOMO_API_KEY=

# ── 서버 ─────────────────────────────
PORT=3000
DEVICE_SECRET=            # 안드로이드 앱과 공유하는 비밀키 (긴 랜덤 문자열)
DB_PATH=data/primebit.db

# ── 핫월렛 개인키 (설정한 체인의 코인만 판매 목록에 나타남) ──
# 모든 EVM 체인(Ethereum/BSC/Polygon/Avalanche/Arbitrum/Optimism/Base/Linea)이 같은 키·같은 주소를 씁니다.
TRON_PRIVATE_KEY=         # TRON: TRX, USDT-TRC20
EVM_PRIVATE_KEY=          # 0x... (EVM 전체)
SOL_PRIVATE_KEY=          # Solana: base58 비밀키 또는 [1,2,3,...] JSON 배열
XRP_SEED=                 # XRP Ledger: s... 시드
BTC_WIF=                  # Bitcoin: WIF 개인키 (P2WPKH bc1q... 주소 사용)

# ── 선택: RPC 직접 지정 (미지정 시 공용 RPC. 운영에서는 유료/전용 RPC 권장) ──
# RPC_ETH= RPC_BSC= RPC_POLYGON= RPC_AVAX= RPC_ARB= RPC_OP= RPC_BASE= RPC_LINEA=
# RPC_SOL= RPC_XRP=wss://... RPC_BTC=https://mempool.space/api
# TRON_FULL_HOST=https://api.trongrid.io   TRON_API_KEY=
# BTC_NETWORK=mainnet(기본) | testnet     BTC_MAX_FEERATE=150
